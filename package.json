{
  "name": "unheard",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/check-messages.ts && next build",
    "start": "next start",
    "lint": "eslint && node scripts/check-messages.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "eval": "vitest run --config vitest.eval.config.ts",
    "record-sky": "node scripts/record-sky.ts",
    "history:build": "node scripts/history-index.ts",
    "places:build": "node scripts/places-build.ts",
    "where": "tsx scripts/where.ts",
    "speed": "tsx scripts/speed-core.ts",
    "speed:browser": "tsx scripts/speed-browser.ts",
    "scoreboard": "node scripts/scoreboard.ts",
    "e2e": "playwright test",
    "e2e:fixture": "tsx scripts/make-e2e-fixture.ts",
    "fetch-donations": "tsx --env-file-if-exists=.env.local scripts/fetch-donations.ts"
  },
  "dependencies": {
    "@vercel/blob": "2.8.2",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "aws4fetch": "1.0.20",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "5.0.5"
  }
}
